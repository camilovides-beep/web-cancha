{
  "$schema": "comfasucre-design-tokens",
  "brand": "Comfasucre · de todos",
  "source": "MANUAL DE MARCA COMFASUCRE-2025.pdf",
  "color": {
    "navy":  { "hex": "#19559B", "rgb": [25, 85, 155],  "cmyk": [91, 72, 1, 0],  "pantone": "7686 C", "role": "Primario: tipografía del logo, botones principales, cabeceras, texto de títulos" },
    "sky":   { "hex": "#1FB5E5", "rgb": [31, 181, 229], "cmyk": [71, 4, 0, 0],   "pantone": "298 C",  "role": "Secundario: fondos, acentos, enlaces hover, franjas. Texto blanco encima NO cumple AA; usar texto navy-900" },
    "green": { "hex": "#94BD1F", "rgb": [148, 189, 31], "cmyk": [51, 0, 97, 0],  "pantone": "375 C",  "role": "Acento/contraste: badges, remates de degradado, estados positivos (usar tono 700 con texto blanco)" },
    "gray":  { "scale": ["#F8F9FB", "#F3F5F7", "#E9ECEF", "#DEE2E6", "#CED4DA", "#ADB5BD", "#6C757D", "#495057", "#343A40", "#212529"], "role": "Color secundario del manual: textos de párrafo, fondos y bordes" },
    "white": { "hex": "#FFFFFF" }
  },
  "gradient": {
    "proportion": { "navy": 0.30, "sky": 0.55, "green": 0.15 },
    "linear":   "linear-gradient(90deg, #19559B 0%, #1FB5E5 40%, #1FB5E5 70%, #94BD1F 100%)",
    "diagonal": "linear-gradient(135deg, #19559B 0%, #1FB5E5 45%, #94BD1F 100%)",
    "radial":   "radial-gradient(circle at 25% 30%, #19559B 0%, #1FB5E5 55%, #94BD1F 100%)",
    "blue":     "linear-gradient(135deg, #19559B 0%, #1FB5E5 100%)"
  },
  "typography": {
    "family": "Poppins",
    "fallback": "system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif",
    "googleFonts": "https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap",
    "weights": { "light": 300, "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "rules": ["Titulares externos y señalética en mayúsculas", "Nombre de marca siempre 'Comfasucre' (nunca COMFASUCRE en texto corrido)", "Títulos: navy 600; párrafos: gray-700 400"]
  },
  "shape": { "radius": { "sm": "0.5rem", "md": "1rem", "lg": "1.5rem", "pill": "50rem" }, "note": "El manual usa cuadros de texto con bordes ovalados" },
  "logo": {
    "clearSpace": "Radio del círculo (cabeza) del isotipo en todos los lados",
    "minHeightPx": { "principal": 40, "horizontal": 28, "isotipo": 24 },
    "versions": {
      "principal-color": "logos/comfasucre-logo-color.png",
      "principal-color-halo": "logos/comfasucre-logo-color-halo.png",
      "principal-white-isocolor": "logos/comfasucre-logo-white-isocolor.png",
      "principal-white": "logos/comfasucre-logo-white.png",
      "horizontal-color": "logos/comfasucre-logo-horizontal-color.png",
      "horizontal-white": "logos/comfasucre-logo-horizontal-white.png",
      "isotipo-color": "logos/comfasucre-isotipo-color.png",
      "isotipo-white": "logos/comfasucre-isotipo-white.png"
    }
  },
  "contact": {
    "address": "Calle 28 #25b 50, Sincelejo, Sucre",
    "pbx": "(5) 279 9500",
    "lineaGratuita": "01 8000 938 810",
    "email": "comunicaciones@comfasucre.com.co",
    "web": "www.comfasucre.com.co",
    "social": { "facebook": "Comfasucre", "instagram": "Comfasucre", "x": "Comfasucre1" },
    "note": "Datos tomados del manual 2025; confirmar con Comunicaciones antes de publicarlos en producción"
  }
}
